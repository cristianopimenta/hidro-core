# Copie para deploy/usinas/<slug>/.env fora do repositório e preencha localmente.
# Arquivo de exemplo sem credenciais. Cada usina usa um COMPOSE_PROJECT_NAME exclusivo.
COMPOSE_PROJECT_NAME=hidrocore-usina-exemplo
PUBLIC_DOMAIN=hidro.example.invalid

POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DB=hidrocore
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_BOOTSTRAP_SECRET
APP_DB_USER=hidrocore_app
APP_DB_PASSWORD=REPLACE_WITH_APP_DATABASE_SECRET
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

KEYCLOAK_IMAGE_TAG=26.2.5
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_REALM=hidrocore
API_AUDIENCE=hidrocore-api

NGINX_IMAGE_TAG=1.27-alpine
TLS_CERTIFICATE_DIR=/etc/hidrocore/tls
TLS_CERTIFICATE_FILE=fullchain.pem
TLS_PRIVATE_KEY_FILE=privkey.pem
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443

WORKER_POLL_SECONDS=60

# Reservado para conectores futuros. Permanecem desligados nesta etapa.
CONNECTOR_DRIVER=disabled
ANA_ENABLED=false
CCEE_ENABLED=false
